# copy to .env and fill in
ADMIN_TOKEN=change-me-to-a-long-random-token

# Required: encrypts god keys at rest (64 hex chars = 32 bytes).
# Generate with: openssl rand -hex 32
KEY_ENCRYPTION_KEY=

# Set to 1 to disable the built-in admin UI (API only).
DISABLE_UI=0

# --- Proxy limits (optional) ---
# Upstream request timeout in seconds (default 30).
#PROXY_TIMEOUT_SECONDS=30
# Max buffered upstream response body in MB, larger bodies are truncated (default 20).
#PROXY_MAX_BODY_MB=20

# --- Database (pick one) ---
# Default: SQLite at DATABASE_PATH (zero-config, single file).
DATABASE_PATH=./data/sevshield.db

# Optional: Postgres. When DATABASE_URL is set it takes precedence and
# DATABASE_PATH is ignored. Start with: docker compose --profile pg up -d
# (or point it at any reachable Postgres for `go run ./cmd/sevshield`).
#DATABASE_URL=postgres://sevshield:change-me@db:5432/sevshield?sslmode=disable

# Only used by the `db` service with --profile pg.
POSTGRES_USER=sevshield
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=sevshield
